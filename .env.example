# Copy to .env and fill in. Never commit .env.
# `exasol info` prints host/port; the password is in
# ~/.exasol/personal/deployments/default/secrets.json (key: dbPassword).
EXASOL_DSN=127.0.0.1:8563
EXASOL_USER=sys
EXASOL_PASSWORD=change-me
# Schema Kanakku owns. Kanakku never drops or truncates anything outside it.
EXASOL_SCHEMA=KANAKKU
# Exasol Personal (local) uses a self-signed certificate. Set to true when
# connecting to a database with a trusted certificate.
EXASOL_CERT_VALIDATION=false
